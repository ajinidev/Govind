# Optional defaults. Prefer the launcher flags (npm start -- --help) or the sidebar switcher.

# Initial data source when nothing is saved in the browser: mock | dummy | real
VITE_DEFAULT_SOURCE=real

# API base URLs (the dummy server must run for "dummy"; "real" is your backend)
VITE_DUMMY_API_URL=http://localhost:3001/api
VITE_REAL_API_URL=http://127.0.0.1:8080/api
